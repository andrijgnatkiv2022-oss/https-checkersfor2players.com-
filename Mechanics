<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mega Checkers: Skins & Shop Edition</title>
    <style>
        :root {
            --bg-dark: #0d0e15;
            --panel-bg: rgba(24, 26, 38, 0.9);
            --accent: #6c5ce7;
            --accent-hover: #5849c4;
            --gold: #fdcb6e;
            --board-border: #2d3436;
            --light-square: #dfe6e9;
            --dark-square: #2d3436;
            --highlight: rgba(0, 184, 148, 0.85);
            --selected: rgba(253, 203, 110, 0.95);
            --text-main: #f5f6fa;
        }

        * {
            box-sizing: border-box;
            user-select: none;
        }

        body {
            margin: 0;
            padding: 0;
            background: radial-gradient(circle at top, #1e2030 0%, var(--bg-dark) 100%);
            color: var(--text-main);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
        }

        .screen {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            max-width: 640px;
            padding: 16px;
            animation: fadeIn 0.4s ease;
        }

        .screen.hidden {
            display: none !important;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Верхня панель з монетами */
        .top-wallet {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            background: var(--panel-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 12px 20px;
            border-radius: 16px;
            margin-bottom: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
        }

        .coin-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 20px;
            font-weight: 800;
            color: var(--gold);
            text-shadow: 0 0 12px rgba(253, 203, 110, 0.4);
        }

        /* Картка меню */
        .menu-card {
            background: var(--panel-bg);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 26px;
            width: 100%;
            box-shadow: 0 20px 45px rgba(0,0,0,0.6);
            text-align: center;
        }

        h1 {
            margin: 0 0 16px 0;
            font-size: 30px;
            background: linear-gradient(45deg, #a29bfe, #6c5ce7, #fd79a8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Вкладки Меню / Магазин */
        .nav-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            background: rgba(0,0,0,0.3);
            padding: 6px;
            border-radius: 14px;
        }

        .tab-btn {
            flex: 1;
            padding: 10px;
            border: none;
            background: transparent;
            color: #b2bec3;
            font-size: 16px;
            font-weight: bold;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .tab-btn.active {
            background: var(--accent);
            color: white;
            box-shadow: 0 4px 12px rgba(108, 92, 231, 0.4);
        }

        .input-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 14px;
        }

        .input-group {
            text-align: left;
            margin-bottom: 14px;
        }

        .input-group label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            color: #b2bec3;
        }

        .input-group input, .input-group select {
            width: 100%;
            padding: 11px 14px;
            background: rgba(0, 0, 0, 0.35);
            border: 2px solid #353849;
            border-radius: 10px;
            color: white;
            font-size: 15px;
            outline: none;
            transition: border-color 0.2s;
        }

        .input-group input:focus, .input-group select:focus {
            border-color: var(--accent);
        }

        .scrollable-box {
            max-height: 110px;
            overflow-y: auto;
            background: rgba(0, 0, 0, 0.25);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 10px;
            padding: 10px 12px;
            margin: 14px 0 18px 0;
            text-align: left;
            font-size: 13px;
            color: #b2bec3;
            line-height: 1.45;
        }

        .scrollable-box::-webkit-scrollbar { width: 6px; }
        .scrollable-box::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 3px; }

        /* Магазин */
        .shop-scroll {
            max-height: 360px;
            overflow-y: auto;
            padding-right: 4px;
            text-align: left;
        }
        .shop-scroll::-webkit-scrollbar { width: 6px; }
        .shop-scroll::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 3px; }

        .shop-section-title {
            font-size: 15px;
            color: #a29bfe;
            margin: 12px 0 8px 0;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .shop-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .shop-item {
            background: rgba(0, 0, 0, 0.35);
            border: 2px solid #2f3242;
            border-radius: 12px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.2s;
        }

        .shop-item.equipped {
            border-color: #00b894;
            background: rgba(0, 184, 148, 0.1);
        }

        .item-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }

        .item-preview {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .item-name {
            font-weight: bold;
            font-size: 14px;
        }

        .item-desc {
            font-size: 11px;
            color: #95a5a6;
            margin-bottom: 10px;
        }

        .shop-btn {
            width: 100%;
            padding: 8px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .shop-btn.buy {
            background: linear-gradient(135deg, #f39c12, #d35400);
            color: white;
        }
        .shop-btn.buy:disabled {
            background: #2f3242;
            color: #636e72;
            cursor: not-allowed;
        }

        .shop-btn.equip {
            background: var(--accent);
            color: white;
        }

        .shop-btn.equipped-btn {
            background: #00b894;
            color: #0d0e15;
            cursor: default;
        }

        .btn-main {
            background: linear-gradient(135deg, #6c5ce7, #4834d4);
            color: white;
            border: none;
            padding: 14px 28px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 12px;
            cursor: pointer;
            width: 100%;
            box-shadow: 0 5px 15px rgba(108, 92, 231, 0.4);
            transition: transform 0.15s;
        }
        .btn-main:hover { transform: translateY(-2px); }

        /* Ігровий екран */
        .game-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            max-width: 460px;
            margin-bottom: 10px;
            background: var(--panel-bg);
            padding: 10px 16px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,0.08);
        }

        .player-box {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .player-info {
            font-size: 15px;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .emoji-bar {
            display: flex;
            gap: 4px;
        }

        .emoji-btn {
            background: rgba(255,255,255,0.08);
            border: none;
            border-radius: 6px;
            padding: 3px 6px;
            font-size: 14px;
            cursor: pointer;
            transition: transform 0.15s;
        }
        .emoji-btn:hover { transform: scale(1.25); background: rgba(255,255,255,0.2); }

        .dot { width: 12px; height: 12px; border-radius: 50%; }
        .dot.white { background: #ffffff; box-shadow: 0 0 8px #fff; }
        .dot.black { background: #2d3436; border: 1px solid #718093; }

        .status-banner {
            font-size: 17px;
            font-weight: bold;
            margin-bottom: 12px;
            padding: 9px 18px;
            background: var(--panel-bg);
            border-radius: 10px;
            text-align: center;
            width: 100%;
            max-width: 460px;
            border: 1px solid rgba(255,255,255,0.08);
        }

        /* Дошка */
        .board-wrapper {
            position: relative;
        }

        .board-container {
            padding: 14px;
            background: #1e2128;
            border-radius: 16px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.75);
            border: 4px solid #353b48;
            transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .board-container.rotated {
            transform: rotate(180deg);
        }

        .board-container.shake {
            animation: boardShake 0.35s ease;
        }

        @keyframes boardShake {
            0%, 100% { transform: translate(0, 0) rotate(var(--rot, 0deg)); }
            25% { transform: translate(-5px, 3px) rotate(var(--rot, 0deg)); }
            50% { transform: translate(5px, -3px) rotate(var(--rot, 0deg)); }
            75% { transform: translate(-3px, -2px) rotate(var(--rot, 0deg)); }
        }

        .board {
            display: grid;
            grid-template-columns: repeat(8, 52px);
            grid-template-rows: repeat(8, 52px);
            border: 2px solid #111;
            position: relative;
        }

        /* Теми дошки */
        .theme-cyber .cell.light { background-color: #dcdde1; }
        .theme-cyber .cell.dark { background-color: #2f3640; }

        .theme-wood .cell.light { background-color: #f0d9b5; }
        .theme-wood .cell.dark { background-color: #b58863; }

        .theme-emerald .cell.light { background-color: #e8f5e9; }
        .theme-emerald .cell.dark { background-color: #2e7d32; }

        .cell {
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .cell.valid-move::after {
            content: '';
            width: 20px;
            height: 20px;
            background-color: var(--highlight);
            border-radius: 50%;
            cursor: pointer;
            animation: pulse 1.2s infinite;
            box-shadow: 0 0 12px var(--highlight);
        }

        @keyframes pulse {
            0% { transform: scale(0.9); opacity: 0.8; }
            50% { transform: scale(1.15); opacity: 1; }
            100% { transform: scale(0.9); opacity: 0.8; }
        }

        /* Шашки та їхні Скіни */
        .piece {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            font-size: 20px;
        }
        .piece:hover { transform: scale(1.1); }

        /* Скін: Класика */
        .skin-classic.white {
            background: radial-gradient(circle at 35% 35%, #ffffff, #b2bec3);
            border: 2px solid #dfe6e9;
            box-shadow: 0 5px 10px rgba(0,0,0,0.6), inset 0 2px 4px rgba(255,255,255,0.6);
        }
        .skin-classic.black {
            background: radial-gradient(circle at 35% 35%, #484b52, #111215);
            border: 2px solid #000;
            box-shadow: 0 5px 10px rgba(0,0,0,0.7), inset 0 2px 4px rgba(255,255,255,0.2);
        }

        /* Скін: Неон */
        .skin-neon.white {
            background: radial-gradient(circle, #81ecec, #00cec9);
            border: 2px solid #ffffff;
            box-shadow: 0 0 14px #00cec9, inset 0 0 8px #fff;
        }
        .skin-neon.black {
            background: radial-gradient(circle, #ff7675, #d63031);
            border: 2px solid #fab1a0;
            box-shadow: 0 0 14px #ff7675, inset 0 0 8px #000;
        }

        /* Скін: Золото та Обсидіан */
        .skin-gold.white {
            background: linear-gradient(135deg, #ffeaa7, #fdcb6e, #e17055);
            border: 2px solid #fff3cd;
            box-shadow: 0 0 12px rgba(253, 203, 110, 0.8);
        }
        .skin-gold.black {
            background: linear-gradient(135deg, #6c5ce7, #2d3436, #000000);
            border: 2px solid #a29bfe;
            box-shadow: 0 0 12px rgba(108, 92, 231, 0.8);
        }

        /* Скін: Кібер-Череп */
        .skin-skull.white {
            background: #ecf0f1;
            border: 2px solid #bdc3c7;
            box-shadow: 0 4px 10px rgba(0,0,0,0.6);
        }
        .skin-skull.white::after { content: '💀'; font-size: 22px; }
        .skin-skull.black {
            background: #1e272e;
            border: 2px solid #ff3f34;
            box-shadow: 0 0 10px rgba(255, 63, 52, 0.6);
        }
        .skin-skull.black::after { content: '👹'; font-size: 22px; }

        /* Скін: Космос */
        .skin-space.white {
            background: radial-gradient(circle at 30% 30%, #fff, #74b9ff, #0984e3);
            border: 2px solid #dfe6e9;
            box-shadow: 0 0 12px #74b9ff;
        }
        .skin-space.white::after { content: '☀️'; font-size: 20px; }
        .skin-space.black {
            background: radial-gradient(circle at 30% 30%, #a29bfe, #2c2c54, #000);
            border: 2px solid #706fd3;
            box-shadow: 0 0 12px #706fd3;
        }
        .skin-space.black::after { content: '🪐'; font-size: 20px; }

        .piece.selected {
            box-shadow: 0 0 20px 6px var(--selected) !important;
            transform: scale(1.16);
        }

        .piece.king::before {
            content: '👑';
            font-size: 20px;
            position: absolute;
            top: -10px;
            z-index: 2;
            filter: drop-shadow(0 2px 3px rgba(0,0,0,0.8));
            transition: transform 0.8s;
        }

        .board-container.rotated .piece.king::before,
        .board-container.rotated .piece::after {
            transform: rotate(180deg);
        }

        /* Спливаючі емодзі та комбо */
        .floating-fx {
            position: absolute;
            pointer-events: none;
            font-size: 42px;
            z-index: 20;
            animation: floatUp 1.3s ease-out forwards;
        }

        @keyframes floatUp {
            0% { opacity: 0; transform: translate(-50%, 0) scale(0.5); }
            20% { opacity: 1; transform: translate(-50%, -20px) scale(1.2); }
            100% { opacity: 0; transform: translate(-50%, -90px) scale(1); }
        }

        .combo-banner {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 36px;
            font-weight: 900;
            color: #ffeaa7;
            text-shadow: 0 0 20px #e17055, 2px 2px 0 #000;
            pointer-events: none;
            z-index: 30;
            animation: comboPop 1.1s ease-out forwards;
        }

        @keyframes comboPop {
            0% { opacity: 0; transform: translate(-50%, -50%) scale(0.3) rotate(-10deg); }
            40% { opacity: 1; transform: translate(-50%, -50%) scale(1.2) rotate(5deg); }
            100% { opacity: 0; transform: translate(-50%, -80%) scale(1) rotate(0deg); }
        }

        /* Частинки при вибуху */
        .particle {
            position: absolute;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            pointer-events: none;
            z-index: 15;
            animation: explode 0.6s ease-out forwards;
        }

        @keyframes explode {
            0% { opacity: 1; transform: translate(0, 0) scale(1); }
            100% { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(0.2); }
        }

        .back-btn-container {
            margin-top: 14px;
            width: 100%;
            max-width: 460px;
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 10px 18px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-secondary:hover { background: rgba(255, 255, 255, 0.2); }

        /* Модальне вікно перемоги */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(6px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 100;
            padding: 20px;
        }

        .modal-box {
            background: #1e2030;
            border: 2px solid var(--gold);
            border-radius: 20px;
            padding: 30px;
            max-width: 400px;
            width: 100%;
            text-align: center;
            box-shadow: 0 0 40px rgba(253, 203, 110, 0.4);
            animation: fadeIn 0.4s ease;
        }

        .reward-box {
            background: rgba(253, 203, 110, 0.15);
            border: 1px solid var(--gold);
            border-radius: 12px;
            padding: 12px;
            margin: 18px 0;
            font-size: 18px;
            font-weight: bold;
            color: var(--gold);
        }

        @media (max-width: 480px) {
            .board { grid-template-columns: repeat(8, 41px); grid-template-rows: repeat(8, 41px); }
            .cell { width: 41px; height: 41px; }
            .piece { width: 32px; height: 32px; }
            .shop-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <!-- ЕКРАН МЕНЮ ТА МАГАЗИНУ -->
    <div id="menuScreen" class="screen">
        <div class="top-wallet">
            <div style="font-weight: bold; color: #b2bec3;">Твій баланс:</div>
            <div class="coin-badge">🪙 <span id="coinCount">0</span></div>
        </div>

        <div class="menu-card">
            <h1>👑 Шашки: Battle & Skins</h1>

            <div class="nav-tabs">
                <button class="tab-btn active" id="tabPlayBtn" onclick="switchTab('play')">🎮 Грати</button>
                <button class="tab-btn" id="tabShopBtn" onclick="switchTab('shop')">🛒 Магазин скінів</button>
            </div>

            <!-- ВКЛАДКА ГРИ -->
            <div id="playTab">
                <div class="input-row">
                    <div class="input-group" style="margin-bottom: 0;">
                        <label for="whiteName">⚪ Білі шашки:</label>
                        <input type="text" id="whiteName" value="Гравець 1" placeholder="Ім'я...">
                    </div>
                    <div class="input-group" style="margin-bottom: 0;">
                        <label for="blackName">⚫ Чорні шашки:</label>
                        <input type="text" id="blackName" value="Гравець 2" placeholder="Ім'я...">
                    </div>
                </div>

                <div class="input-row" style="margin-top: 12px;">
                    <div class="input-group" style="margin-bottom: 0;">
                        <label for="gameMode">Режим обертання:</label>
                        <select id="gameMode">
                            <option value="rotating">🔄 Обертати дошку (180°)</option>
                            <option value="static">📌 Без обертання</option>
                        </select>
                    </div>
                    <div class="input-group" style="margin-bottom: 0;">
                        <label for="boardTheme">Стиль дошки:</label>
                        <select id="boardTheme">
                            <option value="theme-cyber">🌌 Неон Кібер</option>
                            <option value="theme-wood">🪵 Класичне Дерево</option>
                            <option value="theme-emerald">💎 Смарагд</option>
                        </select>
                    </div>
                </div>

                <div class="scrollable-box">
                    <strong>Як заробляти монети та грати:</strong><br>
                    • За кожну завершену партію ви отримуєте <strong>+50 🪙</strong>, а за кожну збиту шашку — ще <strong>+5 🪙</strong>!<br>
                    • Усі скіни, вибухи та звуки в магазині чисто візуальні — вони дарують стиль, але не дають переваги в бою.<br>
                    • Якщо після збиття шашки можна побити ще одну — запускається серія <strong>COMBO</strong>!
                </div>

                <button class="btn-main" onclick="startGame()">ПОЧАТИ ГРУ</button>
            </div>

            <!-- ВКЛАДКА МАГАЗИНУ -->
            <div id="shopTab" class="hidden">
                <div class="shop-scroll" id="shopContainer"></div>
            </div>
        </div>
    </div>

    <!-- ІГРОВИЙ ЕКРАН -->
    <div id="gameScreen" class="screen hidden">
        <div class="game-header">
            <div class="player-box">
                <div class="player-info">
                    <div class="dot white"></div>
                    <span id="whiteDisplayName">Гравець 1</span>
                </div>
                <div class="emoji-bar">
                    <button class="emoji-btn" onclick="sendEmoji('🔥')">🔥</button>
                    <button class="emoji-btn" onclick="sendEmoji('😎')">😎</button>
                    <button class="emoji-btn" onclick="sendEmoji('😱')">😱</button>
                    <button class="emoji-btn" onclick="sendEmoji('😂')">😂</button>
                </div>
            </div>

            <div style="font-weight: 900; color: #a29bfe; font-size: 18px;">VS</div>

            <div class="player-box" style="align-items: flex-end;">
                <div class="player-info">
                    <span id="blackDisplayName">Гравець 2</span>
                    <div class="dot black"></div>
                </div>
                <div class="emoji-bar">
                    <button class="emoji-btn" onclick="sendEmoji('🤔')">🤔</button>
                    <button class="emoji-btn" onclick="sendEmoji('💀')">💀</button>
                    <button class="emoji-btn" onclick="sendEmoji('👑')">👑</button>
                    <button class="emoji-btn" onclick="sendEmoji('⚡')">⚡</button>
                </div>
            </div>
        </div>

        <div class="status-banner" id="status">Хід: Гравець 1 (Білі)</div>

        <div class="board-wrapper" id="boardWrapper">
            <div class="board-container" id="boardContainer">
                <div class="board theme-cyber" id="board"></div>
            </div>
        </div>

        <div class="back-btn-container">
            <button class="btn-secondary" onclick="returnToMenu()">← В меню</button>
            <div style="display:flex; align-items:center; color: var(--gold); font-weight:bold;">
                🪙 +<span id="matchCoins">0</span>
            </div>
            <button class="btn-secondary" onclick="restartGame()">🔄 Заново</button>
        </div>
    </div>

    <!-- ВІКНО ПЕРЕМОГИ -->
    <div id="winModal" class="modal-overlay hidden">
        <div class="modal-box">
            <div style="font-size: 54px; margin-bottom: 10px;">🏆</div>
            <h2 id="winnerTitle" style="margin: 0; font-size: 26px;">Перемога!</h2>
            <p id="winnerSubtitle" style="color: #b2bec3; margin-top: 8px;">Чудова партія!</p>
            <div class="reward-box">
                Нагорода за матч: +<span id="totalEarnedText">50</span> 🪙
            </div>
            <button class="btn-main" onclick="closeWinModal()">В головне меню</button>
        </div>
    </div>

    <script>
        // --- ДАНІ МАГАЗИНУ ТА ЗБЕРЕЖЕННЯ ---
        const SHOP_ITEMS = [
            // Скіни фішок
            { id: 'skin-classic', category: 'skin', name: 'Класика', desc: 'Стандартні об’ємні шашки', price: 0, icon: '⚪', previewBg: '#b2bec3' },
            { id: 'skin-neon', category: 'skin', name: 'Неоновий Світ', desc: 'Яскраве кібер-світіння', price: 100, icon: '💠', previewBg: '#00cec9' },
            { id: 'skin-gold', category: 'skin', name: 'Золото й Обсидіан', desc: 'Королівський блиск', price: 200, icon: '👑', previewBg: '#fdcb6e' },
            { id: 'skin-skull', category: 'skin', name: 'Кібер-Черепи', desc: 'Хардкорний стиль бійців', price: 300, icon: '💀', previewBg: '#ff7675' },
            { id: 'skin-space', category: 'skin', name: 'Галактика', desc: 'Сонце проти Сатурна', price: 450, icon: '🪐', previewBg: '#6c5ce7' },

            // Ефекти вибуху
            { id: 'fx-sparks', category: 'fx', name: 'Звичайні іскри', desc: 'Класичний розліт частинок', price: 0, icon: '✨', previewBg: '#ffeaa7' },
            { id: 'fx-laser', category: 'fx', name: 'Неоновий вибух', desc: 'Яскраві бірюзово-рожеві спалахи', price: 120, icon: '⚡', previewBg: '#00cec9' },
            { id: 'fx-gold', category: 'fx', name: 'Золотий дощ', desc: 'Збита фішка розсипається золотом', price: 250, icon: '💰', previewBg: '#fdcb6e' },

            // Звуки
            { id: 'snd-wood', category: 'sound', name: 'Класичний звук', desc: 'М’який стук при ході', price: 0, icon: '🔊', previewBg: '#636e72' },
            { id: 'snd-arcade', category: 'sound', name: '8-Bit Аркада', desc: 'Ретро-звуки як у старих іграх', price: 150, icon: '🕹️', previewBg: '#e84393' }
        ];

        let userData = JSON.parse(localStorage.getItem('checkersUserData')) || {
            coins: 100, // Стартовий бонус 100 монет, щоб одразу можна було щось купити!
            unlocked: ['skin-classic', 'fx-sparks', 'snd-wood'],
            equipped: {
                skin: 'skin-classic',
                fx: 'fx-sparks',
                sound: 'snd-wood'
            }
        };

        function saveUserData() {
            localStorage.setItem('checkersUserData', JSON.stringify(userData));
            document.getElementById('coinCount').textContent = userData.coins;
        }

        // --- ЗВУКОВИЙ РУШІЙ (WEB AUDIO API) ---
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSound(type) {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            const isArcade = userData.equipped.sound === 'snd-arcade';
            const now = audioCtx.currentTime;

            if (type === 'move') {
                osc.type = isArcade ? 'square' : 'sine';
                osc.frequency.setValueAtTime(isArcade ? 320 : 220, now);
                osc.frequency.exponentialRampToValueAtTime(110, now + 0.08);
                gain.gain.setValueAtTime(0.15, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
                osc.start(now);
                osc.stop(now + 0.08);
            } else if (type === 'capture') {
                osc.type = isArcade ? 'sawtooth' : 'triangle';
                osc.frequency.setValueAtTime(isArcade ? 520 : 380, now);
                osc.frequency.exponentialRampToValueAtTime(90, now + 0.22);
                gain.gain.setValueAtTime(0.25, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.22);
                osc.start(now);
                osc.stop(now + 0.22);
            } else if (type === 'win') {
                osc.type = 'triangle';
                [440, 554, 659, 880].forEach((freq, idx) => {
                    osc.frequency.setValueAtTime(freq, now + idx * 0.1);
                });
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
                osc.start(now);
                osc.stop(now + 0.5);
            }
        }

        // --- ІНТЕРФЕЙС МЕНЮ ТА МАГАЗИНУ ---
        function switchTab(tab) {
            document.getElementById('tabPlayBtn').classList.toggle('active', tab === 'play');
            document.getElementById('tabShopBtn').classList.toggle('active', tab === 'shop');
            document.getElementById('playTab').classList.toggle('hidden', tab !== 'play');
            document.getElementById('shopTab').classList.toggle('hidden', tab !== 'shop');
            if (tab === 'shop') renderShop();
        }

        function renderShop() {
            const container = document.getElementById('shopContainer');
            container.innerHTML = '';

            const categories = [
                { key: 'skin', title: '🎭 Скіни шашок' },
                { key: 'fx', title: '💥 Ефекти при збитті' },
                { key: 'sound', title: '🎵 Звукові ефекти' }
            ];

            categories.forEach(cat => {
                const titleEl = document.createElement('div');
                titleEl.className = 'shop-section-title';
                titleEl.textContent = cat.title;
                container.appendChild(titleEl);

                const grid = document.createElement('div');
                grid.className = 'shop-grid';

                SHOP_ITEMS.filter(i => i.category === cat.key).forEach(item => {
                    const isUnlocked = userData.unlocked.includes(item.id);
                    const isEquipped = userData.equipped[cat.key] === item.id;

                    const card = document.createElement('div');
                    card.className = `shop-item ${isEquipped ? 'equipped' : ''}`;

                    let btnHtml = '';
                    if (isEquipped) {
                        btnHtml = `<button class="shop-btn equipped-btn">✓ Вибрано</button>`;
                    } else if (isUnlocked) {
                        btnHtml = `<button class="shop-btn equip" onclick="equipItem('${cat.key}', '${item.id}')">Одягнути</button>`;
                    } else {
                        const canAfford = userData.coins >= item.price;
                        btnHtml = `<button class="shop-btn buy" ${canAfford ? '' : 'disabled'} onclick="buyItem('${item.id}', ${item.price}, '${cat.key}')">Купити за ${item.price} 🪙</button>`;
                    }

                    card.innerHTML = `
                        <div>
                            <div class="item-header">
                                <div class="item-preview" style="background: ${item.previewBg};">${item.icon}</div>
                                <div class="item-name">${item.name}</div>
                            </div>
                            <div class="item-desc">${item.desc}</div>
                        </div>
                        ${btnHtml}
                    `;
                    grid.appendChild(card);
                });

                container.appendChild(grid);
            });
        }

        function buyItem(id, price, category) {
            if (userData.coins >= price && !userData.unlocked.includes(id)) {
                userData.coins -= price;
                userData.unlocked.push(id);
                userData.equipped[category] = id;
                saveUserData();
                playSound('win');
                renderShop();
            }
        }

        function equipItem(category, id) {
            userData.equipped[category] = id;
            saveUserData();
            playSound('move');
            renderShop();
        }

        // --- ЛОГІКА ГРИ ---
        const menuScreen = document.getElementById('menuScreen');
        const gameScreen = document.getElementById('gameScreen');
        const boardElement = document.getElementById('board');
        const boardContainer = document.getElementById('boardContainer');
        const statusElement = document.getElementById('status');

        let players = { white: 'Гравець 1', black: 'Гравець 2' };
        let gameMode = 'rotating';
        let turn = 'white';
        let selectedPiece = null;
        let validMoves = [];
        let boardState = [];
        let matchEarnedCoins = 0;
        let comboCount = 0;
        let mustContinueCapture = false;

        function startGame() {
            players.white = document.getElementById('whiteName').value.trim() || 'Гравець 1';
            players.black = document.getElementById('blackName').value.trim() || 'Гравець 2';
            gameMode = document.getElementById('gameMode').value;
            const theme = document.getElementById('boardTheme').value;

            boardElement.className = `board ${theme}`;
            document.getElementById('whiteDisplayName').textContent = players.white;
            document.getElementById('blackDisplayName').textContent = players.black;

            menuScreen.classList.add('hidden');
            gameScreen.classList.remove('hidden');

            initBoard();
        }

        function returnToMenu() {
            gameScreen.classList.add('hidden');
            menuScreen.classList.remove('hidden');
            saveUserData();
        }

        function restartGame() {
            initBoard();
        }

        function initBoard() {
            boardState = Array(8).fill(null).map(() => Array(8).fill(null));
            for (let row = 0; row < 8; row++) {
                for (let col = 0; col < 8; col++) {
                    if ((row + col) % 2 === 1) {
                        if (row < 3) boardState[row][col] = { color: 'black', isKing: false };
                        if (row > 4) boardState[row][col] = { color: 'white', isKing: false };
                    }
                }
            }
            turn = 'white';
            selectedPiece = null;
            validMoves = [];
            matchEarnedCoins = 0;
            comboCount = 0;
            mustContinueCapture = false;
            document.getElementById('matchCoins').textContent = '0';
            boardContainer.classList.remove('rotated');
            updateStatus();
            renderBoard();
        }

        function updateStatus() {
            const currentName = turn === 'white' ? players.white : players.black;
            const colorIcon = turn === 'white' ? '⚪' : '⚫';
            statusElement.textContent = mustContinueCapture
                ? `🔥 ${currentName}, бий далі!`
                : `Хід: ${colorIcon} ${currentName}`;
        }

        function renderBoard() {
            boardElement.innerHTML = '';
            const currentSkin = userData.equipped.skin;

            for (let row = 0; row < 8; row++) {
                for (let col = 0; col < 8; col++) {
                    const cell = document.createElement('div');
                    cell.classList.add('cell', (row + col) % 2 === 0 ? 'light' : 'dark');

                    const move = validMoves.find(m => m.toRow === row && m.toCol === col);
                    if (move) {
                        cell.classList.add('valid-move');
                        cell.addEventListener('click', () => makeMove(move));
                    }

                    const piece = boardState[row][col];
                    if (piece) {
                        const pieceEl = document.createElement('div');
                        pieceEl.classList.add('piece', currentSkin, piece.color);
                        if (piece.isKing) pieceEl.classList.add('king');
                        if (selectedPiece && selectedPiece.row === row && selectedPiece.col === col) {
                            pieceEl.classList.add('selected');
                        }
                        if (piece.color === turn && !mustContinueCapture) {
                            pieceEl.addEventListener('click', (e) => {
                                e.stopPropagation();
                                selectPiece(row, col);
                            });
                        }
                        cell.appendChild(pieceEl);
                    }
                    boardElement.appendChild(cell);
                }
            }
        }

        function selectPiece(row, col) {
            selectedPiece = { row, col };
            validMoves = getValidMoves(row, col, boardState[row][col], false);
            renderBoard();
        }

        function getValidMoves(row, col, piece, onlyCaptures) {
            const moves = [];
            const allDirs = [[-1, -1], [-1, 1], [1, -1], [1, 1]];

            // Звичайні ходи
            if (!onlyCaptures) {
                if (!piece.isKing) {
                    const forwardDirs = piece.color === 'white' ? [[-1, -1], [-1, 1]] : [[1, -1], [1, 1]];
                    forwardDirs.forEach(([dR, dC]) => {
                        const nR = row + dR, nC = col + dC;
                        if (isValidPos(nR, nC) && !boardState[nR][nC]) {
                            moves.push({ fromRow: row, fromCol: col, toRow: nR, toCol: nC, captured: null });
                        }
                    });
                } else {
                    allDirs.forEach(([dR, dC]) => {
                        let curR = row + dR, curC = col + dC;
                        while (isValidPos(curR, curC) && !boardState[curR][curC]) {
                            moves.push({ fromRow: row, fromCol: col, toRow: curR, toCol: curC, captured: null });
                            curR += dR; curC += dC;
                        }
                    });
                }
            }

            // Взяття (в усі 4 сторони)
            allDirs.forEach(([dR, dC]) => {
                if (!piece.isKing) {
                    const midR = row + dR, midC = col + dC;
                    const jumpR = row + dR * 2, jumpC = col + dC * 2;
                    if (isValidPos(jumpR, jumpC) && !boardState[jumpR][jumpC]) {
                        const midP = boardState[midR][midC];
                        if (midP && midP.color !== piece.color) {
                            moves.push({ fromRow: row, fromCol: col, toRow: jumpR, toCol: jumpC, captured: { row: midR, col: midC } });
                        }
                    }
                } else {
                    let curR = row + dR, curC = col + dC;
                    let enemy = null;
                    while (isValidPos(curR, curC)) {
                        const p = boardState[curR][curC];
                        if (p) {
                            if (p.color === piece.color || enemy) break;
                            enemy = { row: curR, col: curC };
                        } else if (enemy) {
                            moves.push({ fromRow: row, fromCol: col, toRow: curR, toCol: curC, captured: enemy });
                        }
                        curR += dR; curC += dC;
                    }
                }
            });

            return moves;
        }

        function isValidPos(r, c) {
            return r >= 0 && r < 8 && c >= 0 && c < 8;
        }

        function makeMove(move) {
            const piece = boardState[move.fromRow][move.fromCol];
            boardState[move.toRow][move.toCol] = piece;
            boardState[move.fromRow][move.fromCol] = null;

            // Перетворення на дамку
            if ((piece.color === 'white' && move.toRow === 0) || (piece.color === 'black' && move.toRow === 7)) {
                piece.isKing = true;
            }

            if (move.captured) {
                boardState[move.captured.row][move.captured.col] = null;
                playSound('capture');
                spawnExplosion(move.captured.row, move.captured.col);
                triggerBoardShake();

                comboCount++;
                matchEarnedCoins += 5;
                document.getElementById('matchCoins').textContent = matchEarnedCoins;

                if (comboCount >= 2) {
                    showComboBanner(comboCount);
                }

                // Перевірка, чи можна побити ще одну шашку цією ж фішкою
                const nextCaptures = getValidMoves(move.toRow, move.toCol, piece, true);
                if (nextCaptures.length > 0 && !checkWinCondition(true)) {
                    mustContinueCapture = true;
                    selectedPiece = { row: move.toRow, col: move.toCol };
                    validMoves = nextCaptures;
                    updateStatus();
                    renderBoard();
                    return;
                }
            } else {
                playSound('move');
            }

            // Завершення ходу
            mustContinueCapture = false;
            comboCount = 0;
            selectedPiece = null;
            validMoves = [];

            if (checkWinCondition(false)) return;

            turn = turn === 'white' ? 'black' : 'white';
            updateStatus();
            renderBoard();

            if (gameMode === 'rotating') {
                setTimeout(() => {
                    boardContainer.classList.toggle('rotated', turn === 'black');
                }, 250);
            }
        }

        // --- СПЕЦЕФЕКТИ ТА ЕМОДЗІ ---
        function spawnExplosion(row, col) {
            const cellSize = boardElement.clientWidth / 8;
            const centerX = col * cellSize + cellSize / 2;
            const centerY = row * cellSize + cellSize / 2;

            const fxType = userData.equipped.fx;
            let colors = ['#ffeaa7', '#fab1a0', '#ff7675'];
            if (fxType === 'fx-laser') colors = ['#00cec9', '#a29bfe', '#fd79a8'];
            if (fxType === 'fx-gold') colors = ['#fdcb6e', '#ffeaa7', '#f39c12'];

            for (let i = 0; i < 14; i++) {
                const p = document.createElement('div');
                p.className = 'particle';
                p.style.left = centerX + 'px';
                p.style.top = centerY + 'px';
                p.style.backgroundColor = colors[i % colors.length];
                const angle = (Math.PI * 2 * i) / 14;
                const dist = 30 + Math.random() * 35;
                p.style.setProperty('--dx', Math.cos(angle) * dist + 'px');
                p.style.setProperty('--dy', Math.sin(angle) * dist + 'px');
                boardElement.appendChild(p);
                setTimeout(() => p.remove(), 600);
            }
        }

        function triggerBoardShake() {
            const rot = boardContainer.classList.contains('rotated') ? '180deg' : '0deg';
            boardContainer.style.setProperty('--rot', rot);
            boardContainer.classList.remove('shake');
            void boardContainer.offsetWidth;
            boardContainer.classList.add('shake');
        }

        function showComboBanner(count) {
            const banner = document.createElement('div');
            banner.className = 'combo-banner';
            banner.textContent = `COMBO x${count}!`;
            document.getElementById('boardWrapper').appendChild(banner);
            setTimeout(() => banner.remove(), 1100);
        }

        function sendEmoji(emoji) {
            const el = document.createElement('div');
            el.className = 'floating-fx';
            el.textContent = emoji;
            el.style.left = (30 + Math.random() * 40) + '%';
            el.style.top = '55%';
            document.getElementById('boardWrapper').appendChild(el);
            setTimeout(() => el.remove(), 1300);
        }

        // --- ПЕРЕВІРКА ПЕРЕМОГИ ТА НАГОРОДА ---
        function checkWinCondition(dryRun) {
            let whiteCount = 0, blackCount = 0;
            for (let r = 0; r < 8; r++) {
                for (let c = 0; c < 8; c++) {
                    const p = boardState[r][c];
                    if (p) {
                        if (p.color === 'white') whiteCount++;
                        if (p.color === 'black') blackCount++;
                    }
                }
            }

            if (whiteCount === 0 || blackCount === 0) {
                if (dryRun) return true;
                const winnerName = whiteCount === 0 ? players.black : players.white;
                const totalReward = 50 + matchEarnedCoins;

                userData.coins += totalReward;
                saveUserData();
                playSound('win');

                document.getElementById('winnerTitle').textContent = `Переміг ${winnerName}!`;
                document.getElementById('winnerSubtitle').textContent = 'Всі шашки суперника розгромлено!';
                document.getElementById('totalEarnedText').textContent = totalReward;
                document.getElementById('winModal').classList.remove('hidden');
                return true;
            }
            return false;
        }

        function closeWinModal() {
            document.getElementById('winModal').classList.add('hidden');
            returnToMenu();
        }

        // Ініціалізація при запуску
        saveUserData();
    </script>
</body>
</html>
